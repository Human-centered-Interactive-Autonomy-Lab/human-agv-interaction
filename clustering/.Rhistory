calculate_speed <- function(data) {
# Extract relevant columns and ensure they're numeric
x <- as.numeric(data$User_X)
y <- as.numeric(data$User_Y)
z <- as.numeric(data$User_Z)
t <- as.numeric(data$Time_Index)
n <- length(x)
if (n < 2) return(rep(NA_real_, n))
# Compute 3D displacements and time deltas
dx <- diff(x)
dy <- diff(y)
dz <- diff(z)
dt <- diff(t)
# Mark displacement or time NA if any involved point is NA
invalid <- is.na(dx) | is.na(dy) | is.na(dz) | is.na(dt) | dt <= 0
displacement <- sqrt(dx^2 + dy^2 + dz^2)
displacement[invalid] <- NA_real_
dt[invalid] <- NA_real_
speed <- displacement / dt
# Pad with NA to match original length
c(NA_real_, speed)
}
study_data <- study_data %>%
arrange(PID, Timestamp) %>%
group_by(PID) %>%
mutate(User_Speed = calculate_speed(cur_data())) %>%
ungroup()
summary_speed <- study_data %>%
group_by(PID) %>%
summarise(Mean_Speed = mean(User_Speed, na.rm = TRUE))
make_funData <- function(study_data, variable) {
argvals <- sort(unique(study_data$Time_Index))
study_data_wide <- study_data %>%
select(PID, Time_Index, !!sym(variable)) %>%
pivot_wider(names_from = Time_Index, values_from = all_of(variable)) %>%
arrange(PID)
X <- as.matrix(study_data_wide[, -1])
fd <- funData(argvals = argvals, X = X)
names(fd) <- paste0("PID_", study_data_wide$PID)
return(fd)
}
object_vars <- c("Angle_to_AGV", "Frechet_Distance", "AGV_User_Distance", "User_Speed")
objdata <- multiFunData(
setNames(
lapply(object_vars, function(v) make_funData(study_data, v)),
object_vars
)
)
